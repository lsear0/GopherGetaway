# Copy this file to .env and fill in your values.

# Your OpenAI API key (required for real trip generation).
# SECURITY: this stays on the server. It is never sent to or exposed in the frontend.
OPENAI_API_KEY=sk-your-key-here

# Model to use for trip generation.
OPENAI_MODEL=gpt-4o-mini

# Which travel-agent provider to use: auto | mock | openai
#   auto   -> use the real OpenAI provider when a key is set, otherwise mock (default)
#   mock   -> always use the deterministic mock provider (no API calls)
#   openai -> force the OpenAI provider (falls back to mock if no key is set)
TRAVEL_AGENT_PROVIDER=auto

# Port the backend listens on.
PORT=3001

# Rate limiting for the generation endpoint (per client IP).
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=20             # max generation requests per window
