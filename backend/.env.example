# Copy this file to .env and fill in your values. The demo runs fully on the MOCK
# provider with NO key set, so none of these are required to run GopherTrip.

# Provider selection: auto | mock | openai | openai+mcp
# 'auto' uses mock with no key, openai with a key, and openai+mcp when an MCP server
# is enabled in src/config/mcpServers.json.
TRAVEL_AGENT_PROVIDER=auto

# Your OpenAI API key (required only for the openai / openai+mcp providers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Maximum number of tool-using reasoning rounds per MCP data-acquisition goal.
OPENAI_MAX_TOOL_ITERATIONS=6

# Port the backend listens on.
PORT=3001

# Rate limiting for the generation endpoint.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# --- MCP (Bear) ---
MCP_REQUEST_TIMEOUT_MS=45000
MCP_MAX_TOOL_RESPONSE_CHARS=12000

# Optional auth for the StayingAPI MCP server (enabled in mcpServers.json).
STAYINGAPI_BEARER_TOKEN=

# Optional credentials for future MCP server integrations.
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=

# Optional per-server overrides.
# MCP_STAYINGAPI_URL=https://mcp.stayingapi.com/mcp
# MCP_GOOGLEMAPS_COMMAND=node
# MCP_GOOGLEMAPS_ARGS=["/absolute/path/to/google-maps-mcp-server.js"]

# --- Agent / scoring (Nupur) ---
# Max discover->filter->evaluate revisions before an honest 422.
AGENT_MAX_SEARCH_REVISIONS=2
# Transparent scoring weight overrides (defaults in src/config/scoringWeights.json).
# SCORING_WEIGHT_BUDGET_FIT=0.3
# SCORING_WEIGHT_PREFERENCE_MATCH=0.25
# SCORING_WEIGHT_LOCATION_FIT=0.15
# SCORING_WEIGHT_TRANSPORTATION_FIT=0.15
# SCORING_WEIGHT_INTEREST_MATCH=0.15
